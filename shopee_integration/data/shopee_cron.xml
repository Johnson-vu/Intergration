<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron: Kéo đơn hàng mới mỗi 15 phút -->
    <record id="shopee_cron_pull_orders" model="ir.cron">
        <field name="name">Shopee: Kéo đơn hàng mới</field>
        <field name="model_id" ref="model_shopee_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_orders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cron: Đồng bộ tồn kho mỗi 30 phút -->
    <record id="shopee_cron_sync_stock" model="ir.cron">
        <field name="name">Shopee: Đồng bộ tồn kho</field>
        <field name="model_id" ref="model_shopee_product_mapping"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_stock()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cron: Làm mới token mỗi ngày -->
    <record id="shopee_cron_refresh_token" model="ir.cron">
        <field name="name">Shopee: Làm mới Access Token</field>
        <field name="model_id" ref="model_shopee_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_all_tokens()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
