<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu -->
    <menuitem id="menu_shopee_root"
        name="Shopee"
        sequence="75"
        web_icon="shopee_integration,static/description/icon.png"
        groups="shopee_integration.group_shopee_user"/>

    <!-- Configuration -->
    <menuitem id="menu_shopee_config"
        name="Cấu hình Shop"
        parent="menu_shopee_root"
        action="action_shopee_config"
        sequence="10"
        groups="shopee_integration.group_shopee_manager"/>

    <!-- Orders -->
    <menuitem id="menu_shopee_orders"
        name="Đơn hàng"
        parent="menu_shopee_root"
        action="action_shopee_order"
        sequence="20"
        groups="shopee_integration.group_shopee_user"/>

    <!-- Products -->
    <menuitem id="menu_shopee_products"
        name="Sản phẩm"
        parent="menu_shopee_root"
        action="action_shopee_product_mapping"
        sequence="30"
        groups="shopee_integration.group_shopee_user"/>

    <!-- Manual sync wizard -->
    <menuitem id="menu_shopee_sync"
        name="Đồng bộ thủ công"
        parent="menu_shopee_root"
        action="action_shopee_sync_wizard"
        sequence="40"
        groups="shopee_integration.group_shopee_manager"/>

</odoo>
