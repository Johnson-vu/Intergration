<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopee_product_mapping_view_list" model="ir.ui.view">
        <field name="name">shopee.product.mapping.view.list</field>
        <field name="model">shopee.product.mapping</field>
        <field name="arch" type="xml">
            <list string="Sản phẩm Shopee"
                  decoration-success="sync_state == 'synced'"
                  decoration-danger="sync_state == 'error'"
                  decoration-warning="sync_state == 'pending'">
                <field name="product_id"/>
                <field name="shopee_config_id"/>
                <field name="shopee_item_id"/>
                <field name="shopee_item_sku"/>
                <field name="shopee_price"/>
                <field name="shopee_stock"/>
                <field name="last_sync_date"/>
                <field name="sync_state" widget="badge"
                    decoration-success="sync_state == 'synced'"
                    decoration-danger="sync_state == 'error'"
                    decoration-warning="sync_state == 'pending'"/>
                <button name="action_push_to_shopee" string="Đẩy lên Shopee" type="object"
                    icon="fa-upload" title="Đẩy sản phẩm lên Shopee"/>
                <button name="action_pull_from_shopee" string="Kéo từ Shopee" type="object"
                    icon="fa-download" title="Kéo thông tin từ Shopee"
                    invisible="not shopee_item_id"/>
            </list>
        </field>
    </record>

    <record id="shopee_product_mapping_view_form" model="ir.ui.view">
        <field name="name">shopee.product.mapping.view.form</field>
        <field name="model">shopee.product.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapping Sản phẩm Shopee">
                <header>
                    <button name="action_push_to_shopee" string="Đẩy lên Shopee" type="object"
                        class="btn-primary"/>
                    <button name="action_pull_from_shopee" string="Kéo từ Shopee" type="object"
                        invisible="not shopee_item_id"/>
                    <field name="sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Sản phẩm Odoo">
                            <field name="shopee_config_id"/>
                            <field name="product_id"/>
                            <field name="product_tmpl_id"/>
                        </group>
                        <group string="Thông tin Shopee">
                            <field name="shopee_item_id"/>
                            <field name="shopee_model_id"/>
                            <field name="shopee_item_sku"/>
                            <field name="shopee_price"/>
                            <field name="shopee_stock"/>
                        </group>
                    </group>
                    <group string="Đồng bộ">
                        <field name="last_sync_date" readonly="1"/>
                        <field name="sync_error_message" readonly="1"
                            invisible="not sync_error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopee_product_mapping" model="ir.actions.act_window">
        <field name="name">Sản phẩm Shopee</field>
        <field name="res_model">shopee.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
