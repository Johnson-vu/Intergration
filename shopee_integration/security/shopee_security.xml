<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category -->
    <record id="module_shopee_integration" model="ir.module.category">
        <field name="name">Shopee Integration</field>
        <field name="sequence">100</field>
    </record>

    <!-- Groups -->
    <record id="group_shopee_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="category_id" ref="module_shopee_integration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shopee_manager" model="res.groups">
        <field name="name">Quản trị viên</field>
        <field name="category_id" ref="module_shopee_integration"/>
        <field name="implied_ids" eval="[(4, ref('group_shopee_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
