<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopee_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">shopee.sync.wizard.view.form</field>
        <field name="model">shopee.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ thủ công Shopee">
                <group>
                    <field name="shopee_config_id"/>
                    <field name="sync_type" widget="radio"/>
                    <field name="date_from"
                        invisible="sync_type != 'orders'"/>
                    <field name="date_to"
                        invisible="sync_type != 'orders'"/>
                </group>
                <group invisible="state == 'draft'">
                    <field name="state" readonly="1"/>
                    <field name="result_message" readonly="1"
                        invisible="not result_message"/>
                </group>
                <footer>
                    <button name="action_sync" string="Đồng bộ ngay" type="object"
                        class="btn-primary"
                        invisible="state == 'done'"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopee_sync_wizard" model="ir.actions.act_window">
        <field name="name">Đồng bộ Shopee</field>
        <field name="res_model">shopee.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
